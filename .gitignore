# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Run artefacts. Searches and evaluations write here; nothing under outputs/ is
# tracked. The held-out and baseline records the analysis reads are published as
# a separate data release (see README) and are unpacked into this directory.
outputs/
logs/

# Benchmark corpora are downloaded on first use by each adapter's download().
# Only the pinned sample manifests are tracked.
benchmarks/*/data/*
!benchmarks/*/data/sample_300_seed42.json

# Analysis figures are tracked: the reports embed them.
analysis/tex/

# Generated tables, regenerated by the analysis scripts.
analysis/out/

# Repaired programs execute with the working directory at the repository root
# and leave scratch files behind.
input*.txt
output*.txt
fixed_input.txt
processed_input.txt
random_strings.txt
repaired_program.py
example.txt
final_result_*.json
checksums.txt

# Editable-install metadata
*.egg-info/
